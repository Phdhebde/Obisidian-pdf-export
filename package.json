{
  "name": "pdf-report-exporter",
  "version": "2.0.1",
  "description": "Obsidian plugin: export notes as professional PDF and Word reports, with branded templates and client versions without internal passages.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "npm run check && node esbuild.config.mjs production",
    "check": "tsc --noEmit",
    "test": "node --test \"tests/*.test.ts\"",
    "version-bump": "node scripts/version-bump.mjs",
    "lint": "eslint src"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "pdf",
    "report",
    "export",
    "pdfmake",
    "word",
    "docx",
    "obsidian-md",
    "tlp"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.5.1",
    "obsidian": "^1.14.4",
    "typescript": "^5",
    "typescript-eslint": "^8.71.2"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "marked": "^12",
    "pdfmake": "^0.2.20"
  },
  "author": "Maxence H",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Phdhebde/Obisidian-pdf-export.git"
  },
  "engines": {
    "node": ">=22.18"
  },
  "homepage": "https://phdhebde.github.io/Obisidian-pdf-export/",
  "bugs": {
    "url": "https://github.com/Phdhebde/Obisidian-pdf-export/issues"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    },
    "eslint-plugin-n": {
      "minimatch": "^11.0.1"
    }
  }
}
